# Copy to .env. Never commit .env.
GOOGLE_CLIENT_ID=mock-client-id
GOOGLE_CLIENT_SECRET=mock-client-secret
SESSION_SECRET=change-me-to-32+-random-chars
# 1 = seed demo data, use mock Google, no real credentials needed
DEMO_MODE=1
# Base URL of Google endpoints: mock by default; real: https://accounts.google.com / https://www.googleapis.com
GOOGLE_AUTH_BASE=http://localhost:4010
GOOGLE_API_BASE=http://localhost:4010
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback
WEB_PORT=5173
API_PORT=4000
MOCK_GOOGLE_PORT=4010
DB_PATH=./data/reminders.db
