{
  "name": "reminder-system",
  "version": "0.1.0",
  "private": true,
  "author": "Vincent Wesley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentwesley/DueReminder.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "mock": "tsx mock-google/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chrono-node": "^2.7.0",
    "hono": "^4.13.13",
    "idb": "^7.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rrule": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fastify": "^5.12.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  }
}
